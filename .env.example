# ─── Backend ──────────────────────────────────────────────────────────────────
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/wib
OPENAI_API_KEY=sk-proj-...

# ─── Supabase (Auth) ──────────────────────────────────────────────────────────
# Get these from: https://supabase.com → Project → Settings → API
SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Storage ──────────────────────────────────────────────────────────────────
# "local" for development; "google-drive" for production
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=100

# Required when STORAGE_PROVIDER=google-drive
# Paste the full Service Account JSON here (or base64-encode it)
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}
# ID of the Drive folder where files will be stored (from the folder URL)
GOOGLE_DRIVE_FOLDER_ID=1AbCdEfGhIjKlMnOpQrStUvWx

# ─── Frontend (Expo) ──────────────────────────────────────────────────────────
# Must start with EXPO_PUBLIC_ to be exposed to the app bundle
# Local: http://localhost:3000   Production: https://wib03.onrender.com
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
